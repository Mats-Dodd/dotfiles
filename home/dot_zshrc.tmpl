typeset -U path PATH
path=("$HOME/.local/bin" $path)

HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000

setopt append_history
setopt hist_ignore_dups
setopt hist_ignore_space
setopt share_history

bindkey -e
zle_highlight=('default:fg=#FFC799')

if (( $+commands[mise] )); then
  eval "$(mise activate zsh)"
fi

typeset -U fpath FPATH
{{- if eq .chezmoi.os "darwin" }}
if (( $+commands[brew] )); then
  fpath=("$(brew --prefix)/share/zsh/site-functions" $fpath)
fi
{{- else if eq .chezmoi.os "linux" }}
fpath=(/usr/local/share/zsh/site-functions /usr/share/zsh/vendor-completions $fpath)
{{- end }}
autoload -Uz compinit
compinit

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

export OTUI_PALETTE_IDLE_TIMEOUT_MS=1
export OPENCODE_FAST_BOOT=1

alias o='opencode'
alias p='pi'
alias g='git'
alias gs='git status --short --branch'
alias gaa='git add --all'
alias gc='git commit'
alias gp='git push'
alias gl='git pull'

export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --line-range :500 {}'"

if (( $+commands[fzf] )); then
  if fzf --zsh >/dev/null 2>&1; then
    source <(fzf --zsh)
  else
    [[ -r /usr/share/doc/fzf/examples/completion.zsh ]] && source /usr/share/doc/fzf/examples/completion.zsh
    [[ -r /usr/share/doc/fzf/examples/key-bindings.zsh ]] && source /usr/share/doc/fzf/examples/key-bindings.zsh
  fi
fi

if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
fi

# Loaded after fzf so Atuin owns Ctrl-R.
if (( $+commands[atuin] )); then
  eval "$(atuin init zsh)"
fi

ZSH_AUTOSUGGEST_STRATEGY=(history)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#595959'
for autosuggestions_file in \
  /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
  /usr/local/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
  /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh; do
  if [[ -r "$autosuggestions_file" ]]; then
    source "$autosuggestions_file"
    break
  fi
done
unset autosuggestions_file

if (( $+commands[starship] )); then
  eval "$(starship init zsh)"
fi

if [[ -r "$HOME/.zshrc.local" ]]; then
  source "$HOME/.zshrc.local"
fi
