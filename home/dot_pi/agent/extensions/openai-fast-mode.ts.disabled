// Superseded by npm:@pi-plugins/fast-mode.
// Kept as a minimal rollback implementation; remove the `.disabled` suffix to load it.
export default function (pi: {
  on: (
    event: "before_provider_request",
    handler: (
      event: { payload: unknown },
      context: { model?: { provider: string; id: string } },
    ) => unknown,
  ) => void;
}) {
  pi.on("before_provider_request", (event, context) => {
    if (
      context.model?.provider !== "openai-codex" ||
      context.model.id !== "gpt-5.6-sol" ||
      !event.payload ||
      typeof event.payload !== "object" ||
      Array.isArray(event.payload)
    ) {
      return;
    }

    return {
      ...event.payload,
      service_tier: "priority",
    };
  });
}
